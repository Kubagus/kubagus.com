PORT=3001
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kubagus_com
# WAJIB diisi nilai acak >= 32 karakter saat NODE_ENV=production (server menolak start jika tidak).
JWT_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
# Access token berumur pendek (1h), refresh token acak di DB (30d) — rotasi otomatis tiap refresh.
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d
JWT_ISSUER=kubagus-api
JWT_AUDIENCE=kubagus-admin
COOKIE_NAME=kubagus_token
COOKIE_REFRESH_NAME=kubagus_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Development: true. Produksi: daftar origin eksplisit dipisah koma, mis. https://kubagus.com,https://admin.kubagus.com
CORS_ORIGIN=true
UPLOAD_DIR=uploads
